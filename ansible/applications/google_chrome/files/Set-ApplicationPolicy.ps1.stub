# Build marker, not the script. scripts/materialize-role-scripts.sh copies the source named
# below to files/Set-ApplicationPolicy.ps1 before the role is linted or run; that copy is a
# build artifact the .gitignore deliberately never allowlists.
#
# The script is developed, reviewed and pair-tested once under scripts/, beside its
# Set-ApplicationPolicy.pester.ps1 spec. Writing enterprise policy is product-neutral -- a root,
# some values, some numbered lists -- so every role that hardens a product materializes the one
# source, and the product-specific part stays in files/policy/.
scripts/Set-ApplicationPolicy.ps1
