# Build marker, not the script. scripts/materialize-role-scripts.sh copies the source named
# below to files/Get-InstalledSoftware.ps1 before the role is linted or run; that copy is a
# build artifact the .gitignore deliberately never allowlists.
#
# The script is developed, reviewed and pair-tested once under scripts/, beside its
# Get-InstalledSoftware.pester.ps1 spec. Reading Add/Remove Programs is product-neutral, so
# every catalog role of the WorkSpace image materializes the one source.
scripts/Get-InstalledSoftware.ps1
